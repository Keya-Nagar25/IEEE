# Copy to .env.local for local dev. Add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET signs login cookies (rotating it logs everyone out).
# CODE_SECRET hashes + encrypts team login codes. Do NOT change it after importing teams,
# or every existing code stops working and the admin panel can no longer show them.
SESSION_SECRET=
CODE_SECRET=

# Supabase → Project Settings → API. Used only by the browser for the live leaderboard (Realtime).
# The anon key or the newer "publishable" key both work. Leave blank to fall back to 60s polling.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the deployed site (used in credential emails and link previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Raises GitHub's limit from 60 to 5,000 requests/hour.
# A classic token with the "repo" scope from the reviewer account that is added as a
# collaborator can also read teams' repos while they are still private.
GITHUB_TOKEN=

# Optional. Needed only for "Send credentials" emails (Gmail app password, Brevo, Resend SMTP, etc).
# Without it, hand out the printed credential sheet instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IEEE Hackathon <you@example.com>"
